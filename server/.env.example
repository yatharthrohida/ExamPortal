# ==============================================================================
# ExamPortal Server Environment Configuration Template
# Copy this file to .env and configure values for your local or production environment.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# Server Runtime Settings
PORT=5000
NODE_ENV=development

# CORS Settings
# Set to the origin of your frontend client (e.g., http://localhost:5500, http://127.0.0.1:5500, or http://localhost:5173)
# Comma-separated list of allowed origins supported
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Database Configuration (PostgreSQL)
# Option 1: Standard Connection String (takes precedence if defined).
# Leave blank to use the DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD settings below.
DATABASE_URL=

# Option 2: Discrete Connection Parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exam_portal_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# PostgreSQL Connection Pool Settings
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=3000

# Security & Authentication (JWT)
# Minimum 32-character high-entropy secret for production token signing
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# Rate Limiting Foundations
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

